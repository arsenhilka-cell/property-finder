{
  "name": "uk-commercial-realty-source-probe",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:olx": "npm run build --silent && node dist/src/test-source.js olx",
    "test:dimria": "npm run build --silent && node dist/src/test-source.js dimria",
    "test:rieltor": "npm run build --silent && node dist/src/test-source.js rieltor",
    "test:all": "npm run build --silent && node dist/src/test-source.js all",
    "test:cities": "npm run build --silent && node dist/src/test-cities.js",
    "test:cities:mappings": "npm run build --silent && node dist/src/test-city-mappings.js",
    "diagnose:cities": "npm run build --silent && node dist/src/diagnose-city-mappings.js",
    "search:test": "npm run build --silent && node dist/src/search-test.js",
    "diagnose:olx": "npm run build --silent && node dist/src/olx-diagnostic.js",
    "test:olx:full": "npm run build --silent && node dist/src/olx-full-test.js",
    "analyze:olx:saved": "npm run build --silent && node dist/src/olx-analyze-saved.js",
    "start": "npm run build --silent && node --env-file=.env dist/scripts/local-server.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
